",null,{\"children\":[[\"$\",\"tr\",\"720p\",{\"className\":\"border-b border-line/50 last:border-0\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 text-ink-muted font-medium\",\"children\":\"720p\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums\",\"children\":\"3,225\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums font-medium\",\"children\":\"105.4\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums text-right text-ink-muted\",\"children\":\"68w\"}]]}],[\"$\",\"tr\",\"1080p\",{\"className\":\"border-b border-line/50 last:border-0\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 text-ink-muted font-medium\",\"children\":\"1080p\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums\",\"children\":\"1,183\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums font-medium\",\"children\":\"47.0\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums text-right text-ink-muted\",\"children\":\"68w\"}]]}]]}]]}]]}],\"$L1b\"]}]]}]\n18:[\"$\",\"section\",null,{\"className\":\"rounded-2xl border border-line bg-surface p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-base font-semibold text-ink mb-4\",\"children\":\"Builder notes\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-ink leading-relaxed whitespace-pre-line\",\"children\":\"This is the Qiaomei Q31 case bought from Taobao, a very simple iGPU/APU case that holds the motherboard with a PICO PSU and includes a top bracket for a single 2.5\\\" SSD drive. CPU cooler height limits range from 53mm with a 7mm thick SSD to 45mm with a 15mm thick drive. No side case fan support, though possibly room for 50mm x 10mm exhaust fans. The build uses an ASRock A620I Lightning WiFi with Ryzen 5 8500G cooled by a mainland China Noctua heatsink with Gigabyte GPU fan, powered by a 300w Flex-ATX PSU. Performance is adequate for APU use—good for 1080p E-Sports and arcade gaming. APU runs warm despite decent cooling, but temperatures are normal for AM5 chips and still faster than Intel UHD graphics despite PCIe x4 speeds. This is a good compact travel build suitable for work, multimedia, and light gaming, larger than NUC or ASRock Deskmini STX but strong performing in its class.\"}]]}]\n19:[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-2xl border border-line bg-surface p-5 space-y-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-base font-semibold text-ink\",\"children\":\"Performance\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-ink-muted uppercase tracking-wide font-medium mb-1\",\"children\":\"CPU — CB23 Multi\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-ink tabular-nums\",\"children\":\"11,385\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mt-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex-1 h-1.5 rounded-full bg-surface-alt overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"h-full rounded-full bg-sff-amber\",\"style\":{\"width\":\"26%\"}}]}],[\"$\",\"span\",null,{\"className\":\"text-xs text-ink-muted tabular-nums w-12 text-right\",\"children\":[\"top \",74,\"%\"]}]]}],[\"$\",\"div\",null,{\"className\":\"flex gap-4 text-xs text-ink-muted mt-2\",\"children\":[[\"$\",\"span\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-ink\",\"children\":146}],\" pts/w\"]}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-ink\",\"children\":[24,\"°C\"]}],\" headroom\"]}]]}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-ink-muted uppercase tracking-wide font-medium mb-1\",\"children\":\"GPU — Heaven 1080p\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-ink tabular-nums\",\"children\":[\"47.0\",\" \",[\"$\",\"span\",null,{\"className\":\"text-base font-normal text-ink-muted\",\"children\":\"fps\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex items