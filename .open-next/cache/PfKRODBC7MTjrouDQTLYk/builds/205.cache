n\":\"2,158\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums font-medium\",\"children\":\"85.7\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums text-right text-ink-muted\",\"children\":\"40w\"}]]}],\"$L18\"]}]]}]]}],\"$L19\"]}]]}]\n15:[\"$\",\"section\",null,{\"className\":\"rounded-2xl border border-line bg-surface p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-base font-semibold text-ink mb-4\",\"children\":\"Builder notes\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-ink leading-relaxed whitespace-pre-line\",\"children\":\"Compact 7.10L build pairing Ryzen 7 8700G APU with ADLink Intel ARC A380E GPU for professional productivity and video transcoding work. The A380E is a true single-slot design requiring no external PCIe power, making it ideal for small form factor systems. Case supports full-size mATX motherboards and CPUs up to 69mm high, with low-profile single-slot GPU requirement. Ryzen 8700G provides strong integrated Radeon 870M graphics while the A380E GPU handles professional AV1 encoding tasks. Testing revealed AV1 10-bit (Intel QSV) encoding of a 9-minute 1080p h264 video completed in 46 seconds versus 10 minutes 2 seconds with SVT preset 5. The A380E performs weakly for AAA gaming but excels at video transcoding and AV1 encoding. Case includes leather handle, supports Flex-ATX PSUs, and can accommodate optional thin case fans via modification. Future testing planned with Intel CPU to fully leverage ARC A380E capabilities. Well-suited for content creation and professional workflows rather than gaming.\"}]]}]\n16:[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-2xl border border-line bg-surface p-5 space-y-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-base font-semibold text-ink\",\"children\":\"Performance\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-ink-muted uppercase tracking-wide font-medium mb-