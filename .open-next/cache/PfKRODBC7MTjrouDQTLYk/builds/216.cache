 package, good for work, multimedia and light gaming. Bigger than a NUC or ASRock Deskmini but offers decent performance in a compact form factor.\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"rounded-2xl border border-line bg-surface p-5 space-y-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-base font-semibold text-ink\\\",\\\"children\\\":\\\"Performance\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-ink-muted uppercase tracking-wide font-medium mb-1\\\",\\\"children\\\":\\\"CPU — CB23 Multi\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-ink tabular-nums\\\",\\\"children\\\":\\\"12,940\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2 mt-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex-1 h-1.5 rounded-full bg-surface-alt overflow-hidden\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"h-full rounded-full bg-sff-amber\\\",\\\"style\\\":{\\\"width\\\":\\\"37%\\\"}}]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs text-ink-muted tabular-nums w-12 text-right\\\",\\\"children\\\":[\\\"top \\\",63,\\\"%\\\"]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex gap-4 text-xs text-ink-muted mt-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-ink\\\",\\\"children\\\":170.3}],\\\" pts/w\\\"]}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-sff-red\\\",\\\"children\\\":[-1,\\\"°C\\\"]}],\\\" headroom\\\"]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-ink-muted u