ren\":\"Unigine Heaven\"}],[\"$\",\"table\",null,{\"className\":\"w-full text-sm\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"text-left text-xs text-ink-muted border-b border-line\",\"children\":[[\"$\",\"th\",null,{\"className\":\"pb-2 font-medium w-16\",\"children\":\"Res\"}],[\"$\",\"th\",null,{\"className\":\"pb-2 font-medium\",\"children\":\"Score\"}],[\"$\",\"th\",null,{\"className\":\"pb-2 font-medium\",\"children\":\"FPS\"}],[\"$\",\"th\",null,{\"className\":\"pb-2 font-medium text-right\",\"children\":\"Power\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"1080p\",{\"className\":\"border-b border-line/50 last:border-0\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 text-ink-muted font-medium\",\"children\":\"1080p\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums\",\"children\":\"6,696\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums font-medium\",\"children\":\"265.8\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums text-right text-ink-muted\",\"children\":\"123w\"}]]}],[\"$\",\"tr\",\"1440p\",{\"className\":\"border-b border-line/50 last:border-0\",\"children\":[\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"]}],\"$L1e\"]}]]}]]}],\"$L1f\"]}]]}]\n17:[\"$\",\"section\",null,{\"className\":\"rounded-2xl border border-line bg-surface p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-base font-semibold text-ink mb-4\",\"children\":\"Builder notes\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-ink leading-relaxed whitespace-pre-line\",\"children\":\"The Yocto is a 3D-printed acrylic SFF case with complex mesh hole designs and is designed to work specifically with the HDPLEX 250w GaN PSU using a C6 power connector. CPU cooler clearance is limited to ~38mm (Noctua NH-L9 series or Thermalright AXP90-x36). The build uses an i5-13500T with an RTX 4060 Low Profile, with the GPU cooler replaced by dual Noctua 60mm x 25mm fans for better thermals. Component installation order is critical due to tight tolerances. Custom PSU cables from N3rdware are strongly recommended. The GPU requires a CRJ Micro 4-pin adapter to enable GPU temp monitoring in HWInfo64/HWMonitor. Performance is solid despite low power consumption; CPU initially thermal throttled at stock settings but improved after reducing PL2 to 90w. The case is expensive, adds significant cost with custom fans and cables, and is more of an art piece than a practical build, but construction quality is excellent and it performs well as a compact gaming rig.\"}]]}]\n18:[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-2xl border border-line bg-surface p-5 space-y-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-base font-semibold text-ink\",\"children\":\"Performance\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-ink-muted uppercase tracking-wide font-medium mb-1\",\"children\":\"CPU — CB23 Multi\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-ink tabular-nums\",\"children\":\"17,921\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mt-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex-1 h-1.5 rounded-full bg-surface-alt overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"h-full rounded-full bg-accent\",\"style\":{\"width\":\"64%\"}}]}],[\"$\",\"span\",null,{\"className\":\"text-xs text-ink-muted tabular-nums w-12 text-right\",\"children\":[\"top \",36,\"%\"]}]]}],[\"$\",\"div\",null,{\"className\":\"flex gap-4 text-xs text-ink-muted mt-2\",\"children\":[[\"$\",\"span\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-ink\",\"children\":155.8}],\" pts/w\"]}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-sff-red\",\"children\":[-5,\"°C\"]}],\" headroom\"]}]]}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-ink-mut