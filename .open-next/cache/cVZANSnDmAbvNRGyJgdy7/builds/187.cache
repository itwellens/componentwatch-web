16\">Res</th><th class=\"pb-2 font-medium\">Score</th><th class=\"pb-2 font-medium\">FPS</th><th class=\"pb-2 font-medium text-right\">Power</th></tr></thead><tbody><tr class=\"border-b border-line/50 last:border-0\"><td class=\"py-2 text-ink-muted font-medium\">720p</td><td class=\"py-2 tabular-nums\">1,107</td><td class=\"py-2 tabular-nums font-medium\">44.0</td><td class=\"py-2 tabular-nums text-right text-ink-muted\">16w</td></tr><tr class=\"border-b border-line/50 last:border-0\"><td class=\"py-2 text-ink-muted font-medium\">1080p</td><td class=\"py-2 tabular-nums\">536</td><td class=\"py-2 tabular-nums font-medium\">21.3</td><td class=\"py-2 tabular-nums text-right text-ink-muted\">16w</td></tr></tbody></table></div><div><p class=\"text-xs font-semibold uppercase tracking-wide text-ink-muted mb-3\">Furmark</p><table class=\"w-full text-sm\"><thead><tr class=\"text-left text-xs text-ink-muted border-b border-line\"><th class=\"pb-2 font-medium w-16\">Res</th><th class=\"pb-2 font-medium\">Score</th><th class=\"pb-2 font-medium\">FPS</th><th class=\"pb-2 font-medium text-right\">Power</th></tr></thead><tbody><tr class=\"border-b border-line/50 last:border-0\"><td class=\"py-2 text-ink-muted font-medium\">720p</td><td class=\"py-2 tabular-nums\">823</td><td class=\"py-2 tabular-nums font-medium\">13.0</td><td class=\"py-2 tabular-nums text-right text-ink-muted\">24w</td></tr><tr class=\"border-b border-line/50 last:border-0\"><td class=\"py-2 text-ink-muted font-medium\">1080p</td><td class=\"py-2 tabular-nums\">470</td><td class=\"py-2 tabular-nums font-medium\">7.0</td><td class=\"py-2 tabular-nums text-right text-ink-muted\">24w</td></tr></tbody></table></div></div></section><section class=\"rounded-2xl border border-line bg-surface p-6\"><h2 class=\"text-base font-semibold text-ink mb-4\">Builder notes</h2><p class=\"text-sm text-ink leading-relaxed whitespace-pre-line\">This is the Lianda T44 designed for thin mini-ITX motherboards with strict 25mm IO shield height requirement. CPU cooler limited to 27mm maximum. The case has minimal cooling with no top cutouts and poor side airflow; the builder cut a large hole in the top panel and installed a nylon mesh cover, which improved temperatures by ~10C and doubled CPU performance. The 35w TDP i5-12400T was power-limited to 29w. The integrated graphics (Intel UHD 730) is extremely weak, suitable only for office work and light video viewing, not gaming. Performance is very basic but runs faster than Raspberry Pi 4/5. Case requires modification for adequate cooling and is only recommended for basic desktop use, home server applications, or industrial low-power headless servers. Would NOT recommend without the top mesh modification.</p></section></div><div class=\"space-y-4\"><section class=\"rounded-2xl border border-line bg-surface p-5 space-y-4\"><h2 class=\"text-base font-semibold text-ink\">Performance</h2><div><p class=\"text-xs text-ink-muted uppercase tracking-wide font-medium mb-1\">CPU — CB23 Multi</p><p class=\"text-2xl font-bold text-ink tabular-nums\">6,306</p><div class=\"flex items-center gap-2 mt-1.5\"><div class=\"flex-1 h-1.5 rounded-full bg-surface-alt overflow-hidden\"><div class=\"h-full rounded-full bg-sff-amber\" style=\"width:3%\"></div></div><span class=\"text-xs text-ink-muted tabular-nums w-12 text-right\">top <!-- -->97<!-- -->%</span></div><div class=\"flex gap-4 text-xs text-ink-muted mt-2\"><span><span class=\"font-medium text-ink\">331.9</span> pts/w</span><span><span class=\"font-medium text-ink\">28<!-- -->°C</span> headroom</span></div></div><div><p class=\"text-xs text-ink-muted uppercase tracking-wide font-medium mb-1\">GPU — Heaven 1080p</p><p class=\"text-2xl font-bold text-ink tabular-nums\">21.3<!-- --> <span class=\"text-base font-normal text-ink-muted\">fps</span></p><div class=\"flex items-center gap-2 mt-1.5\"><div class=\"flex-1 h-1.5 rounded-full bg-surface-alt overflow-hidden\"><div class=\"h-full rounded-full bg-sff-amber\" style=\"width:2%\"></div></div><span class=\"text-xs text-ink-muted tabular-nums w-12 text-right\">top <!-- -->98<!-- -->%</span></div><div class=\"flex gap-4 text-xs text-ink-muted mt-2\"><span><span class=\"font-medium text-ink\">1.33</span> fps/w</span></div></div></section></div></div></div><!--$--><!--/$--></main><footer class=\"border-t border-line bg-surface mt-24\"><div class=\"mx-auto max-w-content px-6 py-14 flex flex-col md:flex-row items-start justify-between gap-10\"><div class=\"max-w-xs\"><div class=\"flex items-center gap-2.5 mb-3\"><div class=\"h-6 w-6 rounded-md bg-accent flex items-center justify-center text-white text-[10px] font-bold\">CW</div><span class=\"font-semibold text-ink text-sm\">ComponentWatch</span></div><p class=\"text-sm text-ink-muted leading-relaxed\">Real-time PC component price tracking and community-verified SFF build data.</p></div><div class=\"flex gap-14 text-sm\"><div class=\"space-y-3\"><p class=\"text-[10px] font-semibold uppercase tracking-widest text-ink-faint\">Prices</p><a class=\"block text-ink-muted hover:text-ink transition-colors\" href=\"/compare\">Compare</a><a class=\"block text-ink-muted hover:text-ink transition-colors\" href=\"/ai-builds\">AI Builds</a></div><div class=\"space-y-3\"><p class=\"text-[10px] font-semibold uppercase tracking-widest text-ink-faint\">Community</p><a class=\"block text-ink-muted hover:text-ink transition-colors\" href=\"/builds\">Builds</a><a class=\"block text-ink-muted hover:text-ink transition-colors\" href=\"/cases\">Cases</a><a class=\"block text-ink-muted hover:text-ink transition-colors\" href=\"/submit\">Submit a build</a><a href=\"https://reddit.com/r/sffpc\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"block text-ink-muted hover:text-ink transition-colors\">r/sffpc ↗</a></div></div></div><div class=\"border-t border-line/40\"><div class=\"mx-auto max-w-content px-6 py-4 flex items-center justify-between gap-4\"><p class=\"text-xs text-ink-faint\">© <!-- -->2026<!-- -