assName\":\"text-left text-xs text-ink-muted border-b border-line\",\"children\":[[\"$\",\"th\",null,{\"className\":\"pb-2 font-medium w-16\",\"children\":\"Res\"}],[\"$\",\"th\",null,{\"className\":\"pb-2 font-medium\",\"children\":\"Score\"}],[\"$\",\"th\",null,{\"className\":\"pb-2 font-medium\",\"children\":\"FPS\"}],[\"$\",\"th\",null,{\"className\":\"pb-2 font-medium text-right\",\"children\":\"Power\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"1080p\",{\"className\":\"border-b border-line/50 last:border-0\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 text-ink-muted font-medium\",\"children\":\"1080p\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums\",\"children\":\"10,044\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums font-medium\",\"children\":\"398.7\"}],[\"$\",\"td\",null,{\"className\":\"py-2 tabular-nums text-right text-ink-muted\",\"children\":\"200w\"}]]}],[\"$\",\"tr\",\"1440p\",{\"className\":\"border-b border-line/50 last:border-0\",\"children\":[\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"]}],\"$L1f\"]}]]}]]}],\"$L20\"]}]]}]\n18:[\"$\",\"section\",null,{\"className\":\"rounded-2xl border border-line bg-surface p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-base font-semibold text-ink mb-4\",\"children\":\"Builder notes\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-ink leading-relaxed whitespace-pre-line\",\"children\":\"The Real Box Niu Niu Z39 is an improved clone of the SGPC K39 x3 with added height to accommodate dual 90/92mm top exhaust fans. Despite being more compact than typical cases, it delivers excellent gaming and productivity performance with the Ryzen 7 7800X3D and RTX 4070. CPU cooler clearance is around 59-60mm. The case supports GPUs up to 187mm length; the Zephyr RTX 4070 ITX is currently the highest-spec single-fan NVidia card that fits. The build fits comfortably in a backpack for portability and LAN parties. The Zephyr 4070 can get loud under load, so undervolting via MSI Afterburner is recommended. High 1080p and strong 1440p gaming are achievable. The case volume is slightly larger than the Velka 5 (under 5L) but provides better GPU options. Overall, an excellent compact package that improves upon the K39 design.\"}]]}]\n19:[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-2xl border border-line bg-surface p-5 space-y-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-base font-semibold text-ink\",\"children\":\"Performance\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-ink-muted uppercase tracking-wide font-medium mb-1\",\"children\":\"CPU — CB23 Multi\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-ink tabular-nums\",\"children\":\"18,329\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mt-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex-1 h-1.5 rounded-full bg-surface-alt overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"h-full rounded-full bg-accent\",\"style\":{\"width\":\"67%\"}}]}],[\"$\",\"span\",null,{\"className\":\"text-xs text-ink-muted tabular-nums w-12 text-right\",\"children\":[\"top \",33,\"%\"]}]]}],[\"$\",\"div\",null,{\"className\":\"flex gap-4 text-xs text-ink-muted mt-2\",\"children\":[[\"$\",\"span\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-ink\",\"children\":137.8}],\" pts/w\"]}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-ink\",\"children\":[10,\"°C\"]}],\" headroom\"]}]]}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs text-ink-muted uppercase tracking-wide font-medium mb-1\",\"children\":\"GPU — Heaven 1080p\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-ink tabular-nums\",\"children\":[\"398.7\",\" \",[\"$\",\"span\",null,{\"className\":\"text-base font-normal text-ink-muted\",\"children\":\"fps\"}]]}],[\"$