82.8\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2 tabular-nums text-right text-ink-muted\\\",\\\"children\\\":\\\"257w\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1440p\\\",{\\\"className\\\":\\\"border-b border-line/50 last:border-0\\\",\\\"children\\\":[\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\"]}],\\\"$L1f\\\"]}]]}]]}],\\\"$L20\\\"]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"21:T4a0,\"])</script><script>self.__next_f.push([1,\"The Cougar Dust 2 case (2022 model, recently discontinued and only available from Gigaparts at $122USD) is relatively easy to disassemble with toolless side panels and clamps. The case supports up to 280mm AIOs and 2.9-slot GPUs up to 330mm long. The RTX 2080ti Gaming OC is a solid 2.5-slot card at 286.5mm with fine performance for 1440p gaming, though it exhibits aggressive fan curve behavior (near silent to full power at 70C). After replacing thermal pads and paste, GPU temps improved by ~5C and now stay under 75C during stress testing. The i7-12700k paired with the cheaper ASRock Z690M-ITX/AC motherboard and DDR4 memory creates a strong 1440p gaming system with acceptable thermals despite negative pressure. The case offers excellent build quality with an ammo box theme and ample component room. Key limitations include no bottom fan intake capability, a PCIe Gen 3 riser cable (should support Gen 4 for modern GPUs), and a custom 21mm riser connector design with no third-party alternatives. Overall, the case is functional with more positives than negatives, though the proprietary riser cable and lack of Gen 4 support are notable shortcomings for future GPU upgrades.\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"rounded-2xl border border-line bg-surface p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-base font-semibold text-ink mb-4\\\",\\\"children\\\":\\\"Builder notes\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text